# OpenClaw 侧凭证（规范 S04：真实值只进本目录 .env，绝不提交/入对话/入文档）
# MiniMax token（Anthropic 兼容端点）；openclaw.json 的 models.providers.minimax.apiKey 经 SecretRef 引用本变量
WG_OPENCLAW_PRIMARY_KEY=change-me
# Gateway 访问 token（gateway.auth.mode=token）；与 backend/.env 的 WG_OPENCLAW_GATEWAY_TOKEN 同名同值
WG_OPENCLAW_GATEWAY_TOKEN=change-me
# MCP 深查工具令牌（2026-09-07 阶段二）：网关调用后端 /api/v1/mcp 的 Bearer 凭证，
# 与 backend/.env 的 WG_MCP_TOKEN 同名同值；缺失时启动脚本自动生成并写回两处
WG_MCP_TOKEN=change-me
