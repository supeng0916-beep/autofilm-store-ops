# AutoFilm Demo 后端环境变量示例（规范 S04：真实值只进 backend/.env，绝不提交）
# 使用：cp backend/.env.example backend/.env
NODE_ENV=dev
WG_PORT=8000
WG_DATABASE_URL=postgresql://autofilm:autofilm@localhost:5432/autofilm_dev
# JWT 签名密钥：至少 32 字符；生产环境必须替换（规范 S04）
WG_JWT_SECRET=dev-only-secret-please-change-32chars!!
WG_DEBUG=true
# 占位账号初始口令（仅限开发环境；生产环境开业前必须换真人账号，规范 S04）
WG_SEED_PASSWORD=dev-only-seed-password
# —— OpenClaw 集成（P3-00，Gateway 协议 WebSocket+RPC）——
# 网关 WS 地址与访问 token；两者任一未配置 = AI 通道未开启（提交被拒，业务不受影响）
# WG_OPENCLAW_GATEWAY_WS_URL=ws://127.0.0.1:18789
# Gateway 访问 token（与 openclaw/config/.env 的 WG_OPENCLAW_GATEWAY_TOKEN 同名同值）
# WG_OPENCLAW_GATEWAY_TOKEN=change-me
# 回调方向 HMAC 密钥（OpenClaw → NestJS，仅测试/echo 模式），≥16 字符，生产必须替换
# WG_AI_CALLBACK_SECRET=change-me
# AI 成本熔断线（单位：人民币分。10000 = ¥100/日）
# 按自己的演示需求设置预算；此值为配置示例，不代表真实使用费用。
WG_AI_DAILY_BUDGET_FEN=10000
# 单任务 token 上限（超限告警审计；拒收线是日预算）
WG_AI_TASK_MAX_TOKENS=20000
# —— 全站接口限流（快修批次，防爆破/防滥用）——
# 同一来源在 WG_RATE_LIMIT_TTL 秒窗口内最多 WG_RATE_LIMIT_MAX 次请求，超限 429
WG_RATE_LIMIT_TTL=60
WG_RATE_LIMIT_MAX=600
# OpenClaw 提交 HTTP 超时（毫秒）
WG_AI_SUBMIT_TIMEOUT_MS=5000
# AI 任务默认截止时限（秒），超时未回调自动降级
WG_AI_DISPATCH_DEADLINE_S=300
# —— 门店 MCP 端点（M02）：网关调用 POST /api/v1/mcp 的 Bearer 令牌，至少 16 字符 ——
# 未配置时端点整体拒绝（fail-closed 401），不影响其余业务启动
# WG_MCP_TOKEN=change-me-at-least-16
# 模型单价表（2026-08-28 P5，分/每百万 tokens，JSON）：网关只回传 token 不报金额，
# 成本按该表估算（近 7 日成本/成本分解/预算口径）。缺省内置官方价：
# MiniMax-M3 输入 ¥2.1/M=210 分、输出 ¥4.2/M=420 分；embo-01（知识库向量化）¥0.5/M=50 分；
# 换供应商或调价时覆盖本行，例如：
# WG_AI_MODEL_PRICES_FEN_PER_MTOK={"MiniMax-M3":{"input":210,"output":420},"embo-01":{"input":50,"output":0}}
# 测试库连接串（可选）：默认 postgresql://autofilm:autofilm@localhost:5432/autofilm_test
# 仅在 CI/异机需要指向别的测试库时设置：
# WG_TEST_DATABASE_URL=postgresql://autofilm:autofilm@localhost:5432/autofilm_test
# —— Embedding（P4-02 RAG 检索，MiniMax 国际平台）——
# 未配置时 RAG 静默降级（检索返回空，不报错）；配置后知识生效即自动向量化
# WG_EMBEDDING_API_URL=https://api.minimaxi.com/v1/embeddings
# MiniMax 开放平台 API Key（注意是国际平台 api.minimaxi.com，与国内 api.minimaxi.chat 的 key 不通用；
# 可与 openclaw/config/.env 的 WG_OPENCLAW_PRIMARY_KEY 共用同一个 key）
# WG_EMBEDDING_API_KEY=change-me
# 向量模型（默认 embo-01，1536 维；一般无需修改）
# WG_EMBEDDING_MODEL=embo-01
# RAG 检索相似度阈值（P6-01）：0=关闭（默认，返回 top-N 不截断）；
# >0 时低于阈值的结果被过滤，无关查询走「无法确定，需人工核实」拒绝路径（A05）。
# 生产建议在 P4-06 真实知识基线就绪后用真实查询校准取值（如 0.3~0.5）
# WG_RAG_MIN_SIMILARITY=0

# —— 施工照片本地存储目录（P5-04）：base64 上传落盘，相对 backend 运行目录 ——
# WG_UPLOAD_DIR=uploads

# —— 素材待入库文件夹（v1.5 T12）：门店把 jpg/jpeg/png/webp/mp4/mov 素材丢入该目录，
# 系统每 5 分钟扫描入库；成功移同级 inbox-processed/YYYY-MM/，失败移 inbox-failed/。
# 留空/未设置 = 关闭扫描（dev 建议 uploads/inbox）
# WG_IMPORT_WATCH_DIR=uploads/inbox

# RAG 阈值需要在自建合成数据上校准，不沿用原业务知识测量。
# WG_RAG_MIN_SIMILARITY=0.3

# —— 每日心跳（批次5）：经 OpenClaw 微信渠道单发老板。目标=老板微信 peer ID
# （部署三步见 docs/deployment/心跳微信配置.md）；缺省时心跳只记日志不发送
WG_HEARTBEAT_WEIXIN_TO=
# WG_HEARTBEAT=off 可整体关闭

# 作品集默认不连接模型、不发送定时通知；接入时再启用以上可选配置。
WG_HEARTBEAT=off
WG_INDUSTRY_DAILY=off
